{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "BLOCKED"
      ]
    },
    "blocker": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "spec_ambiguity",
                "permission_network",
                "permission_full",
                "scope",
                "environment",
                "other"
              ]
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string"
    },
    "todos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "reqIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lane": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "defectIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "text",
          "reqIds",
          "lane",
          "defectIds"
        ],
        "additionalProperties": false
      }
    },
    "qaScenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "browser",
              "cli"
            ]
          },
          "reqIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lane": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "preconditions": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adversarial": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "reqIds",
          "lane",
          "preconditions",
          "steps",
          "expected",
          "adversarial"
        ],
        "additionalProperties": false
      }
    },
    "lanes": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "ownedPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "interfaces": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "ownedPaths",
              "interfaces"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issueId": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          }
        },
        "required": [
          "issueId",
          "resolution"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "blocker",
    "summary",
    "todos",
    "qaScenarios",
    "lanes",
    "responses"
  ],
  "additionalProperties": false
}
