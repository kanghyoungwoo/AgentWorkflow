{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REJECTED",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "requiredChange": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "target",
          "problem",
          "requiredChange"
        ],
        "additionalProperties": false
      }
    },
    "blocker": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "spec_ambiguity",
                "permission_network",
                "permission_full",
                "scope",
                "environment",
                "other"
              ]
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "verdict",
    "summary",
    "issues",
    "blocker"
  ],
  "additionalProperties": false
}
