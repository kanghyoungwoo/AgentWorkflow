{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "DONE",
        "BLOCKED"
      ]
    },
    "blocker": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "spec_ambiguity",
                "permission_network",
                "permission_full",
                "scope",
                "environment",
                "other"
              ]
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "created",
              "updated"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "action",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issueId": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          }
        },
        "required": [
          "issueId",
          "resolution"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "blocker",
    "docs",
    "responses"
  ],
  "additionalProperties": false
}
