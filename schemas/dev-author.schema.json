{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "DONE",
        "BLOCKED"
      ]
    },
    "blocker": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "spec_ambiguity",
                "permission_network",
                "permission_full",
                "scope",
                "environment",
                "other"
              ]
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          },
          "evidence": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": [
                  "files",
                  "summary"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "checked",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "testsRun": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "passed": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "command",
            "passed",
            "note"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issueId": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          }
        },
        "required": [
          "issueId",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "blocker",
    "items",
    "testsRun",
    "responses",
    "notes"
  ],
  "additionalProperties": false
}
